# Copie este arquivo para .env.deploy e preencha os dados reais.
# .env.deploy fica somente no seu computador e nao entra no Git.

CLOUDWEBY_FTP_SERVER=199.193.117.238
CLOUDWEBY_FTP_USERNAME=leveljiujitsu
CLOUDWEBY_FTP_PASSWORD=coloque-a-senha-aqui

# Use /public_html/ para o usuario principal do cPanel.
# Use / se a conta FTP ja cair direto dentro de public_html.
CLOUDWEBY_FTP_DIR=/public_html/

CLOUDWEBY_FTP_PORT=21
CLOUDWEBY_FTP_SECURE=false
