# Copie este arquivo para .env (ou .env.local) e preencha com os dados do Firebase.
# O .env NÃO entra no Git (fica só na sua máquina).
#
# Config web do Firebase — MESMO projeto do "sistema" da academia.
# A parte do site é isolada: usa só a coleção `site_faixasPretas` e a pasta `site/faixas/`.
# Esses valores são PÚBLICOS (vão no JS do site) — a segurança vem das Security Rules.
# Onde pegar: Firebase Console > Configurações do projeto (⚙️) > Seus apps > App da Web > SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email do ÚNICO usuário admin do painel (criar em Authentication > Users no Firebase).
# O dono digita só a SENHA na tela de login; este email é usado por baixo.
VITE_ADMIN_EMAIL=contato@leveljiujitsu.com.br
